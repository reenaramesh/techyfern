# Set a unique random value for every environment; never commit the real value.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL empty for local SQLite. Production must use PostgreSQL.
DATABASE_URL=

# A comma-separated allowlist; leave empty for same-origin deployment.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# SMTP settings. Keep credentials outside source control.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
COMPANY_NOTIFICATION_EMAIL=
SEND_CUSTOMER_ACKNOWLEDGEMENT=False

# Optional production HTTPS settings.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# Leave preload disabled until the final domain is verified as eligible.
SECURE_HSTS_PRELOAD=False
