# Set this to the approved production origin before enabling canonical URLs or indexing.
VITE_SITE_URL=
# Set true only after domain, public content and launch approval are confirmed.
VITE_ENABLE_INDEXING=false

# Leave empty to use the local Vite proxy (/api -> http://127.0.0.1:8000).
# Set an API origin only when frontend and Django are hosted separately.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional GA4 ID, configured only after the site's analytics/privacy setup is approved.
VITE_GA4_MEASUREMENT_ID=
